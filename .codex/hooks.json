{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'forge hook context || exit 2' || exit 2"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'forge hook deny || exit 2' || exit 2"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "request_user_input",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'forge hook approval || exit 2' || exit 2"
          }
        ]
      }
    ]
  }
}
