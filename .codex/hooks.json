{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c '\"$(git rev-parse --show-toplevel)/forge\" hook session_start || exit 2' || exit 2",
            "statusMessage": "Loading factory context"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c '\"$(git rev-parse --show-toplevel)/forge\" hook pre_tool_use || exit 2' || exit 2",
            "statusMessage": "Applying factory command policy"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c '\"$(git rev-parse --show-toplevel)/forge\" hook stop_continue || exit 2' || exit 2",
            "timeout": 30,
            "statusMessage": "Checking factory completion"
          }
        ]
      }
    ]
  }
}
