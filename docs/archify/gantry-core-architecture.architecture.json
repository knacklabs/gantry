      "dot": "cyan",
      "title": "Strict Per-JID Concurrency",
      "items": [
        "GroupQueue serializes turns per conversation/thread with 1-active lock",
        "Pending messages are buffered in FIFO waiting groups during active runs"
      ]
    },
    {
      "dot": "amber",
      "title": "Dual Engine Architecture",
      "items": [
        "Claude SDK: Prompt caching, thinking budgets, and SigV4/Vertex gateways",
        "DeepAgents: LangGraph stream normalizer, sandboxing, and MCP facades"
      ]
    },
    {
      "dot": "violet",
      "title": "PostgreSQL Durability & Notify",
      "items": [
        "Every turn executes 18-20 transactional SQL queries across its lifecycle",
