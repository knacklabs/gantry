  "cards": [
    {
      "dot": "rose",
      "title": "Cryptographic HMAC Verification",
      "items": [
        "Header validation: x-gantry-ingress-timestamp, x-gantry-ingress-nonce, x-gantry-ingress-signature",
        "Canonical payload string: METHOD + PATH + TIMESTAMP + NONCE + BODY_HASH + RAW_BODY",
        "Constant-time string comparison protects against timing attacks"
      ]
    },
    {
      "dot": "amber",
      "title": "4 Distinct Target Dispatch Types",
      "items": [
        "1. session_message: Injects a turn directly into an interactive AI agent session",
        "2. conversation_message: Injects message into Slack/Discord/Teams threads",
        "3. job_trigger: Directly triggers execution of an asynchronous scheduled job",
        "4. job_template: Renders JSON template variables into a dynamic job definition"
      ]
    },
    {
      "dot": "violet",
      "title": "Known Bugs & Edge Cases",
      "items": [
        "Bug 1: Nonce Replay on Idempotent Retries (Same nonce rejects before idempotency check)",
        "Bug 2: Proxy Body Mutation (Altered JSON whitespace causes HMAC signature failure)",
        "Bug 3: 256 KB Body Limit (Fails 413 Payload Too Large on base64 images/files)"
      ]
    }
  ]
