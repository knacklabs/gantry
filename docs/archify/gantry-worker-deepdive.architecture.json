  "cards": [
    {
      "dot": "amber",
      "title": "Strict Per-JID Concurrency Lock",
      "items": [
        "GroupQueue ensures exactly one turn executes per conversation or thread at a time",
        "If a message arrives while an agent is running, it is safely queued in the FIFO backlog"
      ]
    },
    {
      "dot": "cyan",
      "title": "Replay Cursor Reconciliation",
      "items": [
        "collectPendingMessagesSince queries PostgreSQL from the last saved cursor to current",
        "Guarantees that zero messages are dropped during network reconnections or worker restarts"
      ]
    },
    {
      "dot": "violet",
      "title": "Distributed Fencing",
      "items": [
        "Live turns issue monotonically increasing fencing versions in PostgreSQL",
        "Stale workers are immediately rejected if another node claims recovery"
      ]
    }
